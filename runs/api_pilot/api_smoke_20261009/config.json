      "tool_calls",
      "repeated_tool_call_rate",
      "weighted_tool_cost",
      "request_latency_p50_p95",
      "episode_latency_p50_p95",
      "total_usd_per_correct_diagnosis",
      "input_cached_output_reasoning_tokens",
      "repeat_agreement",
      "canonical_renamed_accuracy_gap"
    ]
  },
  "pricing": {
    "checked_on": "2026-10-09",
    "currency": "USD",
    "gpt_usd_per_million": {
      "input_uncached": 2,

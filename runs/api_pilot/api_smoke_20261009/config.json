{
  "schema_version": "netheal.api-comparison.v1",
  "status": "prepared_not_executed",
  "created_on": "2026-10-09",
  "purpose": "Compare observed cost, latency and accuracy under identical task conditions; do not equalize expenditure or latency.",
  "providers": {
    "gpt": {
      "model": "gpt-6.1-sol",
      "api": "responses",
      "base_url": "https://api.openai.com/v1",
      "key_env": "OPENAI_API_KEY",

      "max_output_tokens": 8192,
      "service_tier": "default",
      "temperature": null,
      "store": false
    },
    "jev": {
      "model": "jev-1.13.0",
      "endpoint": "https://api.typesafe.ai/v1/systemone",
      "key_env": "TYPESAFE_API_KEY",
      "text_helper": false
    }
  },
  "common": {
    "observation": "observed-only public graph; known nominal inventory",
    "action_interface": "one complete legal action selected from identical indexed candidates",
    "language": "en",
    "history": "current public graph only; no cross-step private conversation state",
    "max_decisions": 40,
    "concurrency": 1,
    "request_timeout_seconds": 120,
    "max_transport_retries": 1,
    "retry_backoff_seconds": 1,
    "episode_watchdog_seconds": 600,
    "max_cost_per_episode_usd": null,
    "web_search": false,
    "rag": false,
    "few_shot_examples": 0,
    "application_response_cache": false
  },
  "evaluation": {
    "conditions": [
      "star_6",
      "star_10",
      "star_12",
      "linear_6",
      "mesh_6",
      "mesh_10",
      "random_6",
      "random_10"
    ],
    "pilot_cases_per_condition": 8,
    "final_cases_per_condition": 100,
    "fault_types_per_condition": 4,
    "repeats": 3,
    "naming_variants": [
      "canonical",
      "renamed"
    ],
    "pilot_seed_base": 9100000,
    "final_seed_base": 9200000,
    "execution_order": "paired randomized AB/BA, alternate providers, shuffle cases",
    "bootstrap_repeats": 10000,
    "cluster_unit": "physical_case",
    "primary_family_ci": 0.9833333333333333
  },
  "metrics": {
    "primary": [
      "exact_accuracy",
      "mean_billed_usd_per_episode",
      "mean_end_to_end_seconds_per_episode"
